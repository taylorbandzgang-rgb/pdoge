[Unit]
Description=PseudoDogecoin bridge relayer (L1 PETHVault <-> PDOGE PDOGEBridge)
After=network.target pdoge-node.service
Wants=network.target
BindsTo=pdoge-node.service

[Service]
Type=simple
# Canonical copy lives at ~/workspace/pseudodogecoin/systemd/pdoge-relayer.service
WorkingDirectory=/home/hatch/workspace/pseudodogecoin
ExecStart=/usr/bin/node /home/hatch/workspace/pseudodogecoin/scripts/relayer.js
# Relayer is an infinite poll loop: always restart on crash, 15s backoff.
Restart=always
RestartSec=15
StartLimitIntervalSec=300
StartLimitBurst=10

KillMode=control-group
TimeoutStopSec=15

MemoryMax=512M
CPUQuota=50%
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pdoge-relayer

Environment=HOME=/root
# Egress goes through the runtime proxy (same one tool processes use).
# Without these, direct TLS to mainnet RPCs fails at the network edge.
Environment=NODE_USE_ENV_PROXY=1
Environment=HTTPS_PROXY=http://hatch-runtime:2db0eaaaf1594c268f5eb154edd9c861@hatch-egress-proxy:3128
Environment=https_proxy=http://hatch-runtime:2db0eaaaf1594c268f5eb154edd9c861@hatch-egress-proxy:3128
Environment=HTTP_PROXY=http://hatch-runtime:2db0eaaaf1594c268f5eb154edd9c861@hatch-egress-proxy:3128
Environment=http_proxy=http://hatch-runtime:2db0eaaaf1594c268f5eb154edd9c861@hatch-egress-proxy:3128
Environment=NO_PROXY=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2
Environment=no_proxy=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2

[Install]
WantedBy=default.target
